# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# --- Auth.js ---------------------------------------------------------------
# Random secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud console → Google Auth Platform → Clients)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The only Google account allowed into the admin panel.
# Comma-separate to allow more than one.
ADMIN_EMAIL=you@gmail.com

# --- Hidden admin URL --------------------------------------------------------
# The admin panel opens at  https://your-site/?ADMIN_QUERY_KEY=ADMIN_QUERY_VALUE
# Leave ADMIN_QUERY_VALUE empty to disable the admin panel entirely.
ADMIN_QUERY_KEY=sso
ADMIN_QUERY_VALUE=

# --- Storage ---------------------------------------------------------------
# Postgres connection string. The Vercel → Neon integration sets this for you.
DATABASE_URL=

# --- Resume PDF import -----------------------------------------------------
# Anthropic API key used to read uploaded resume PDFs. Optional: without it
# the import tab is disabled and everything else works.
ANTHROPIC_API_KEY=
# Optional model override.
ANTHROPIC_MODEL=claude-sonnet-5-5
